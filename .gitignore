# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Secrets — never commit the Tushare token / endpoint
.env.local
.env

# Data cache (raw Tushare pulls, parquet) — large, regenerable, not for git
# Anchored to repo root so it does NOT swallow the ashare_gauntlet/data/ source package.
/data/
*.parquet

# Scratch / smoke scripts
_scratch*
_smoke*

# 年报原文文本 / 关键词提取实验残留(非代码,不入库)
_yake_*.txt

# CodeGraph 本地索引(每台机器本地,随时可重建,不入库)
.codegraph/
